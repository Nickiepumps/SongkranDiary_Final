--- !u!114 &943930891
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 943930886}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e66354662979ad84982b3f76b1c5e34f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogText: {fileID: 188706045}
  dialogSpeed: 0.05
  transitionCanvas: {fileID: 1087697548}
  transitionAnimator: {fileID: 1087697547}
  dialogArr:
  - "\u0E2A\u0E07\u0E01\u0E23\u0E32\u0E19\u0E15\u0E4C\u0E1B\u0E35\u0E19\u0E35\u0E49\u0E16\u0E36\u0E07\u0E08\u0E30\u0E21\u0E35\u0E40\u0E23\u0E37\u0E48\u0E2D\u0E07\u0E40\u0E02\u0E49\u0E32\u0E21\u0E32\u0E2B\u0E25\u0E32\u0E22\u0E2D\u0E22\u0E48\u0E32\u0E07\u0E01\u0E47\u0E40\u0E16\u0E2D\u0E30\n\u0E41\u0E15\u0E48\u0E27\u0E48\u0E32\u0E19\u0E30
    \u0E09\u0E31\u0E19\u0E2A\u0E19\u0E38\u0E01\u0E21\u0E32\u0E01\u0E46\u0E40\u0E25\u0E22"
  - "\u0E44\u0E14\u0E49\u0E40\u0E08\u0E2D\u0E17\u0E31\u0E49\u0E07\u0E40\u0E1E\u0E37\u0E48\u0E2D\u0E19\u0E43\u0E2B\u0E21\u0E48
    \u0E44\u0E14\u0E49\u0E25\u0E2D\u0E07\u0E44\u0E1B\u0E17\u0E35\u0E48\u0E43\u0E2B\u0E21\u0E48\u0E46\n\u0E16\u0E36\u0E07\u0E40\u0E08\u0E49\u0E32\u0E1E\u0E27\u0E01\u0E41\u0E01\u0E4A\u0E07\u0E1E\u0E48\u0E19\u0E2A\u0E35\u0E19\u0E31\u0E48\u0E19\u0E08\u0E30\u0E19\u0E48\u0E32\u0E23\u0E33\u0E04\u0E32\u0E0D\u0E44\u0E1B\u0E2B\u0E19\u0E48\u0E2D\u0E22"
  - "\u0E44\u0E14\u0E2D\u0E32\u0E23\u0E35\u0E48\u0E27\u0E31\u0E19\u0E2A\u0E07\u0E01\u0E23\u0E32\u0E19\u0E15\u0E4C\u0E02\u0E2D\u0E07\u0E09\u0E31\u0E19\u0E43\u0E19\u0E1B\u0E35\u0E19\u0E35\u0E49\u0E01\u0E47\u0E40\u0E2A\u0E23\u0E47\u0E08\u0E40\u0E23\u0E35\u0E22\u0E1A\u0E23\u0E49\u0E2D\u0E22....\u0E15\u0E2D\u0E19\u0E41\u0E23\u0E01\u0E08\u0E30\u0E44\u0E21\u0E48\u0E44\u0E14\u0E49\u0E40\u0E02\u0E35\u0E22\u0E19\u0E40\u0E22\u0E2D\u0E30\u0E02\u0E19\u0E32\u0E14\u0E19\u0E35\u0E49\u0E01\u0E47\u0E40\u0E16\u0E2D\u0E30...."
  - "\u0E2A\u0E33\u0E2B\u0E23\u0E31\u0E1A\u0E1B\u0E35\u0E19\u0E35\u0E49\u0E02\u0E2D\u0E43\u0E2B\u0E49\u0E17\u0E38\u0E01\u0E04\u0E19\u0E21\u0E35\u0E04\u0E27\u0E32\u0E21\u0E2A\u0E38\u0E02\u0E01\u0E31\u0E1A\u0E40\u0E17\u0E28\u0E01\u0E32\u0E25\u0E2A\u0E07\u0E01\u0E23\u0E32\u0E19\u0E15\u0E4C\n\u0E44\u0E21\u0E48\u0E2A\u0E34
    \u0E02\u0E2D\u0E43\u0E2B\u0E49\u0E21\u0E35\u0E04\u0E27\u0E32\u0E21\u0E2A\u0E38\u0E02\u0E43\u0E19\u0E17\u0E38\u0E01\u0E46\u0E27\u0E31\u0E19\u0E40\u0E25\u0E22!!"
  - "\u0E23\u0E32\u0E15\u0E23\u0E35\u0E2A\u0E27\u0E31\u0E2A\u0E14\u0E34\u0E4C\u0E19\u0E30\u0E17\u0E38\u0E01\u0E04\u0E19
    :)"
